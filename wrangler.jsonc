{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "knowledge",
  "routes": [{ "pattern": "knowledge.les-enovateurs.com", "custom_domain": true }],
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
